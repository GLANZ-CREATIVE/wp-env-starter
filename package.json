{
  "name": "wp-vite-dev",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "scripts": {
    "prepare": "lefthook install",
    "start": "wp-env start && pnpm mailpit:start && pnpm dev",
    "stop": "wp-env stop && pnpm mailpit:stop",
    "destroy": "wp-env destroy",
    "wp-env": "wp-env",
    "mailpit:start": "docker-compose -f docker-compose.mailpit.yml up -d",
    "mailpit:stop": "docker-compose -f docker-compose.mailpit.yml down",
    "dev": "vite",
    "build": "pnpm blocks:build && vite build",
    "blocks:build": "wp-scripts build --source-path=theme/blocks --output-path=theme/blocks/build",
    "blocks:start": "wp-scripts start --source-path=theme/blocks --output-path=theme/blocks/build",
    "blocks:new": "cd theme/blocks && pnpm dlx @wordpress/create-block@latest --no-plugin --namespace theme",
    "backup:db": "pnpm wp-env run cli wp db export ./sql/backup-$(date +%Y%m%d).sql",
    "backup:db:win": "powershell -Command \"pnpm wp-env run cli wp db export ./sql/backup-$(Get-Date -Format 'yyyyMMdd').sql\"",
    "import:db": "pnpm wp-env run cli wp db import",
    "patterns:flush": "pnpm wp-env run cli wp eval 'wp_get_theme()->delete_pattern_cache();'",
    "format": "prettier --write 'theme/**/*.{css,js,ts,php}'",
    "stylelint": "stylelint 'theme/src/**/*.css' --fix",
    "eslint": "eslint 'theme/src/**/*.{js,ts}' --fix",
    "php:lint": "find theme -name '*.php' -not -path 'theme/dist/*' -not -path 'theme/blocks/build/*' -exec php -l {} +",
    "lint": "prettier --check 'theme/**/*.{css,js,ts,php}' && stylelint 'theme/src/**/*.css' && eslint 'theme/src/**/*.{js,ts}' && pnpm php:lint"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@prettier/plugin-php": "^0.25.0",
    "@wordpress/env": "^11.8.0",
    "@wordpress/scripts": "^33.0.0",
    "browserslist": "^4.28.7",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.6.0",
    "lefthook": "^2.1.9",
    "lightningcss": "^1.32.0",
    "prettier": "^3.8.3",
    "sharp": "^0.35.0",
    "stylelint": "^17.12.0",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "svgo": "^4.0.1",
    "vite": "^8.0.16",
    "vite-plugin-full-reload": "^1.2.0",
    "vite-plugin-image-optimizer": "^2.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ]
}
