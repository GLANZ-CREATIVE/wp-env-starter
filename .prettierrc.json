{
  "plugins": ["@prettier/plugin-php", "prettier-plugin-tailwindcss"],
  "tailwindStylesheet": "./theme/src/assets/css/index.css",
  "arrowParens": "always",
  "printWidth": 150,
  "tabWidth": 2,
  "singleQuote": false,
  "useTabs": false,
  "semi": true,
  "trailingComma": "es5",
  "overrides": [
    {
      "files": "*.json",
      "options": {
        "tabWidth": 2
      }
    }
  ]
}
