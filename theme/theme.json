{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "customGradient": true,
      "palette": [
        {
          "slug": "main-100",
          "color": "#e6f1ff",
          "name": "Main 100"
        },
        {
          "slug": "main-200",
          "color": "#cce0ff",
          "name": "Main 200"
        },
        {
          "slug": "main-300",
          "color": "#a3c8ff",
          "name": "Main 300"
        },
        {
          "slug": "main-400",
          "color": "#7aa0ff",
          "name": "Main 400"
        },
        {
          "slug": "main-500",
          "color": "#0a71ef",
          "name": "Main 500"
        },
        {
          "slug": "white",
          "color": "#ffffff",
          "name": "White"
        },
        {
          "slug": "black",
          "color": "#000000",
          "name": "Black"
        },
        {
          "slug": "gray-50",
          "color": "#f9fafb",
          "name": "Gray 50"
        },
        {
          "slug": "gray-100",
          "color": "#f3f4f6",
          "name": "Gray 100"
        },
        {
          "slug": "gray-200",
          "color": "#e5e7eb",
          "name": "Gray 200"
        },
        {
          "slug": "gray-300",
          "color": "#d1d5db",
          "name": "Gray 300"
        },
        {
          "slug": "gray-400",
          "color": "#9ca3af",
          "name": "Gray 400"
        },
        {
          "slug": "gray-500",
          "color": "#6b7280",
          "name": "Gray 500"
        }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fontSizes": [
        {
          "slug": "xs",
          "size": "0.75rem",
          "name": "XS"
        },
        {
          "slug": "sm",
          "size": "0.875rem",
          "name": "SM"
        },
        {
          "slug": "base",
          "size": "1rem",
          "name": "Base"
        },
        {
          "slug": "lg",
          "size": "1.125rem",
          "name": "LG"
        },
        {
          "slug": "xl",
          "size": "1.25rem",
          "name": "XL"
        },
        {
          "slug": "2xl",
          "size": "1.5rem",
          "name": "2XL"
        },
        {
          "slug": "3xl",
          "size": "1.875rem",
          "name": "3XL"
        },
        {
          "slug": "4xl",
          "size": "2.25rem",
          "name": "4XL"
        }
      ],
      "fontFamilies": [
        {
          "slug": "base",
          "fontFamily": "arial, 'Hiragino Kaku Gothic ProN', 'Hiragino Sans', 'Noto Sans JP', sans-serif, 'Segoe UI Emoji', 'Segoe UI Symbol'",
          "name": "Base"
        }
      ]
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "customSpacingSize": true,
      "spacingSizes": [
        {
          "slug": "0",
          "size": "0",
          "name": "0"
        },
        {
          "slug": "1",
          "size": "0.25rem",
          "name": "1"
        },
        {
          "slug": "2",
          "size": "0.5rem",
          "name": "2"
        },
        {
          "slug": "3",
          "size": "0.75rem",
          "name": "3"
        },
        {
          "slug": "4",
          "size": "1rem",
          "name": "4"
        },
        {
          "slug": "5",
          "size": "1.25rem",
          "name": "5"
        },
        {
          "slug": "6",
          "size": "1.5rem",
          "name": "6"
        },
        {
          "slug": "7",
          "size": "1.75rem",
          "name": "7"
        },
        {
          "slug": "8",
          "size": "2rem",
          "name": "8"
        },
        {
          "slug": "9",
          "size": "2.25rem",
          "name": "9"
        },
        {
          "slug": "10",
          "size": "2.5rem",
          "name": "10"
        },
        {
          "slug": "12",
          "size": "3rem",
          "name": "12"
        },
        {
          "slug": "14",
          "size": "3.5rem",
          "name": "14"
        },
        {
          "slug": "16",
          "size": "4rem",
          "name": "16"
        }
      ],
      "units": ["px", "em", "rem", "vh", "vw", "%"]
    },
    "layout": {
      "contentSize": "800px",
      "wideSize": "1200px"
    },
    "custom": {
      "spacing": {},
      "typography": {
        "letterSpacing": {
          "wide": "0.05em"
        }
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--white)",
      "text": "var(--wp--preset--color--black)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--base)",
      "fontSize": "var(--wp--preset--font-size--base)",
      "letterSpacing": "0.05em"
    },
    "spacing": {
      "blockGap": "1.5rem"
    },
    "elements": {
      "button": {
        "color": {
          "background": "var(--wp--preset--color--main-500)",
          "text": "var(--wp--preset--color--white)"
        },
        "border": {
          "radius": "0.375rem"
        },
        "spacing": {
          "padding": {
            "top": "0.75rem",
            "right": "1.5rem",
            "bottom": "0.75rem",
            "left": "1.5rem"
          }
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--main-400)"
          }
        }
      }
    },
    "blocks": {
      "core/paragraph": {
        "spacing": {
          "margin": {
            "top": "0",
            "bottom": "1rem"
          }
        }
      },
      "core/heading": {
        "spacing": {
          "margin": {
            "top": "2rem",
            "bottom": "1rem"
          }
        }
      }
    }
  }
}
